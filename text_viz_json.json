f_year,\\\\n    t1.cp_channels AS Channel,\\\\n    SUM(t1.cp_daily_spend) AS Total_Ad_Spend\\\\n  FROM\\\\n    `acn-cda.RMN_Campaign_Dataset_Dev_MV.mv_flat_campaign_measurement_1` AS t1\\\\n  WHERE t1.cp_campaign_id = \\\\'CMP_2025_2158\\\\'\\\\n   AND t1.cp_brand_name = \\\\'Lifebuoy\\\\'\\\\n   AND t1.cp_objective = \\\\'Consideration\\\\'\\\\n  GROUP BY\\\\n    week_of_year,\\\\n    t1.cp_channels\\\\n  ORDER BY\\\\n    week_of_year,\\\\n    t1.cp_channels\\\\n  LIMIT 100\\\",\\n  \\\"sql_results\\\": [],\\n  \\\"nl_results\\\": \\\"The query executed successfully, but no data was found for Campaign ID 'CMP_2025_2158', Brand 'Lifebuoy', and campaign objective 'Consideration' to analyze the total ad spend by channel on a weekly basis. This could be due to no matching records in the database for the specified criteria.\\\"\\n}\",\n        \"ds_text\": null\n    },\n    \"prompt6\": {\n        \"prompt\": \"for campaign id cmp 2025 2158 and brand lifebuoy, provide a concise campaign performance summary for\",\n        \"chart_url\": null,\n        \"json_data\": null,\n        \"viz_text\": null,\n        \"db_text\": \"No campaign performance data was found for Campaign ID 'CMP_2025_2158', Brand 'Lifebuoy', and objective 'Consideration'.\",\n        \"ds_text\": null\n    }\n}"