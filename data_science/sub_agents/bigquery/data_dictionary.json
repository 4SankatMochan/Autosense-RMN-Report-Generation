{
  "database_name": "RMN_Campaign_Dataset_Dev",
  "description": "Marketing analytics database containing campaign data, performance metrics, customer interactions, transactions, and audience information",
  "tables": [
    {
      "table_name": "campaign_metadata",
      "suggested_name": "campaign metadata",
      "description": "Campaign metadata including advertiser info, budget, dates, and strategy details",
      "columns": [
        {
          "column_name": "advertiser_id",
          "suggested_name": "advertiser_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "Unique identifier for the advertiser running the campaign."
        },
        {
          "column_name": "campaign_id",
          "suggested_name": "campaign_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "Unique identifier for the marketing campaign.",
          "remarks": "If Primary Key then should not be Nullable"
        },
        {
          "column_name": "campaign_ad_grp_id",
          "suggested_name": "campaign_ad_group_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "Identifier for the ad group within the campaign."
        },
        {
          "column_name": "campaign_ad_id",
          "suggested_name": "campaign_ad_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "Unique ID for the specific ad within the campaign."
        },
        {
          "column_name": "product_ids",
          "suggested_name": "product_ids",
          "data_type": "STRING",
          "nullable": true,
          "description": "List of product identifiers promoted in the campaign."
        },
        {
          "column_name": "brand_id",
          "suggested_name": "brand_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "Unique identifier for the brand associated with the campaign."
        },
        {
          "column_name": "brand_name",
          "suggested_name": "brand_name",
          "data_type": "STRING",
          "nullable": true,
          "description": "Name of the brand being advertised."
        },
        {
          "column_name": "media_type",
          "suggested_name": "media_type",
          "data_type": "STRING",
          "nullable": true,
          "description": "Type of media used (e.g., display, CTV, email).",
          "enum_values": [
            "Sponsored Product",
            "Sponsored Brand",
            "Display",
            "Search",
            "Video",
            "Shoppable Display",
            "Email",
            "In-App Ads",
            "Programmatic Display",
            "Programmatic Video",
            "Social Ads (Retail-activated)",
            "CTV",
            "DOOH",
            "In-Store Media",
            "Push Notification",
            "SMS / Mobile Messaging",
            "Loyalty Portal Ads",
            "Retail Media Video/OTT"
          ]
        },
        {
          "column_name": "channels",
          "suggested_name": "marketing_channels",
          "data_type": "STRING",
          "nullable": true,
          "description": "Marketing channels used for campaign delivery (e.g., On-Site, App, Channel-CTV).",
          "enum_values": [
            "Onsite",
            "App",
            "Offsite",
            "Channel-CTV",
            "In-store"
          ]
        },
        {
          "column_name": "objective",
          "suggested_name": "campaign_objective",
          "data_type": "STRING",
          "nullable": true,
          "description": "Primary goal of the campaign (e.g., awareness, conversions).",
          "enum_values": [
            "Consideration",
            "Conversion",
            "Awareness",
            "Retention"
          ]
        },
        {
          "column_name": "sub_objective",
          "suggested_name": "campaign_sub_objective",
          "data_type": "STRING",
          "nullable": true,
          "description": "Secondary or more specific goal under the main objective.",
          "enum_values": [
            "App Installs",
            "Engagement / Clicks",
            "Product Discovery",
            "Drive Store Visits",
            "Retarget PDP Viewers",
            "Drive Sales / Purchases",
            "New Customer Acquisition",
            "Basket Building",
            "Add to Cart",
            "Buy Box Wins",
            "App Engaged Shoppers",
            "Auto-Replenish Candidates",
            "Brand Interactors",
            "Brand Loyalists",
            "Cart Abandoners",
            "Category Enthusiasts",
            "Churn Risk",
            "Deal Hunters",
            "Frequent Browsers",
            "Frequent Buyers",
            "Geo-Targeted Shoppers",
            "High-Intent Visitors",
            "Lookalike Audiences",
            "Loyalty Program Members",
            "New to Brand",
            "New to Category",
            "Promo Responders",
            "Repeat Buyers",
            "Seasonal Shoppers",
            "Value Shoppers"
          ]
        },
        {
          "column_name": "start_date",
          "suggested_name": "campaign_start_date",
          "data_type": "DATE",
          "nullable": true,
          "description": "Scheduled start date of the campaign."
        },
        {
          "column_name": "end_date",
          "suggested_name": "campaign_end_date",
          "data_type": "DATE",
          "nullable": true,
          "description": "Scheduled end date of the campaign."
        },
        {
          "column_name": "budget",
          "suggested_name": "campaign_budget",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Total allocated budget for the campaign.",
          "constraints": "Non-negative numeric value"
        },
        {
          "column_name": "planned_spend",
          "suggested_name": "planned_spend",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Expected spend based on campaign planning.",
          "constraints": "Non-negative numeric value"
        },
        {
          "column_name": "strategy_description",
          "suggested_name": "strategy_description",
          "data_type": "STRING",
          "nullable": true,
          "description": "Textual description of the campaign strategy.",
          "enum_values": [
            "Retailer Recommended Strategy",
            "CPA-Optimized",
            "Budget Pacing",
            "Long-Tail Keywords",
            "New Launch Boosting",
            "Conversion-Optimized",
            "Homepage Placement",
            "ROAS-Optimized",
            "Time-of-Day Targeting",
            "Competitor Keywords",
            "Carousel / Shelf Ads",
            "PDP Placement",
            "Store-Level Targeting",
            "Top-Seller Promotion",
            "Clearance Promotion",
            "Cross-Sell/Upsell",
            "Category Page Placement",
            "Predictive Targeting",
            "Viewability-Optimized",
            "Branded Keywords",
            "Gen AI Creative Optimization",
            "Category Keywords",
            "Auto Targeting",
            "Retargeting",
            "Behavioral Targeting",
            "Loyalty Segment Targeting",
            "Lapsed Customers",
            "Demographic Targeting",
            "Cart Abandoners",
            "Lookalike Audiences",
            "New Customer Acquisition"
          ]
        },
        {
          "column_name": "status",
          "suggested_name": "campaign_status",
          "data_type": "STRING",
          "nullable": true,
          "description": "Current status of the campaign (e.g., Planned, Completed, Active).",
          "enum_values": [
            "Planned",
            "Active",
            "Completed"
          ]
        },
        {
          "column_name": "channel_id",
          "suggested_name": "channel_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "Unique ID for the specific channel used."
        },
        {
          "column_name": "creative_id",
          "suggested_name": "creative_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "Identifier for the creative asset used in the campaign."
        },
        {
          "column_name": "strategy_category",
          "suggested_name": "strategy_category",
          "data_type": "STRING",
          "nullable": true,
          "description": "Category or type of strategy employed.",
          "enum_values": [
            "AI/ML-Driven or Custom Strategies",
            "Optimization-Based",
            "Keyword-Level",
            "Product-Level",
            "Contextual / Placement-Based",
            "Audience-Level"
          ]
        },
        {
          "column_name": "strategy_id",
          "suggested_name": "strategy_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "Unique identifier for the strategy applied."
        },
        {
          "column_name": "site_id",
          "suggested_name": "site_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "ID of the site/platform where the campaign is displayed."
        }
      ],
      "primary_key": "campaign_id"
    },
    {
      "table_name": "campaign_performance",
      "suggested_name": "campaign performance",
      "description": "Campaign performance metrics including impressions, clicks, conversions, and video engagement",
      "columns": [
        {
          "column_name": "campaign_id",
          "suggested_name": "campaign_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "ID for the marketing campaign."
        },
        {
          "column_name": "campaign_ad_id",
          "suggested_name": "campaign_ad_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "ID for the specific ad within the campaign."
        },
        {
          "column_name": "product_ids",
          "suggested_name": "product_ids",
          "data_type": "STRING",
          "nullable": true,
          "description": "List of product identifiers promoted in the campaign."
        },
        {
          "column_name": "brand_id",
          "suggested_name": "brand_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "Unique identifier for the brand associated with the campaign."
        },
        {
          "column_name": "brand_name",
          "suggested_name": "brand_name",
          "data_type": "STRING",
          "nullable": true,
          "description": "Name of the brand being advertised."
        },
        {
          "column_name": "media_type",
          "suggested_name": "media_type",
          "data_type": "STRING",
          "nullable": true,
          "description": "Type of media used (e.g., display, CTV, email).",
          "enum_values": [
            "Sponsored Product",
            "Sponsored Brand",
            "Display",
            "Search",
            "Video",
            "Shoppable Display",
            "Email",
            "In-App Ads",
            "Programmatic Display",
            "Programmatic Video",
            "Social Ads (Retail-activated)",
            "CTV",
            "DOOH",
            "In-Store Media",
            "Push Notification",
            "SMS / Mobile Messaging",
            "Loyalty Portal Ads",
            "Retail Media Video/OTT"
          ]
        },
        {
          "column_name": "channels",
          "suggested_name": "marketing_channels",
          "data_type": "STRING",
          "nullable": true,
          "description": "Marketing or distribution channels used in the campaign.",
          "enum_values": [
            "Onsite",
            "App",
            "Offsite",
            "Channel-CTV",
            "In-store"
          ]
        },
        {
          "column_name": "total_campaign_budget",
          "suggested_name": "total_campaign_budget",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Total allocated budget for the entire campaign.",
          "remarks": "same field as \"budget\" in campaign  ",
          "constraints": "Non-negative numeric value"
        },
        {
          "column_name": "planned_spend",
          "suggested_name": "planned_spend",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Forecasted spend based on campaign planning.",
          "constraints": "Non-negative numeric value"
        },
        {
          "column_name": "objective",
          "suggested_name": "campaign_objective",
          "data_type": "STRING",
          "nullable": true,
          "description": "Primary goal of the campaign (e.g., awareness, conversion).",
          "enum_values": [
            "Consideration",
            "Conversion",
            "Awareness",
            "Retention"
          ]
        },
        {
          "column_name": "sub_objective",
          "suggested_name": "campaign_sub_objective",
          "data_type": "STRING",
          "nullable": true,
          "description": "More specific or secondary campaign goal.",
          "enum_values": [
            "App Installs",
            "Engagement / Clicks",
            "Product Discovery",
            "Drive Store Visits",
            "Retarget PDP Viewers",
            "Drive Sales / Purchases",
            "New Customer Acquisition",
            "Basket Building",
            "Add to Cart",
            "Buy Box Wins",
            "App Engaged Shoppers",
            "Auto-Replenish Candidates",
            "Brand Interactors",
            "Brand Loyalists",
            "Cart Abandoners",
            "Category Enthusiasts",
            "Churn Risk",
            "Deal Hunters",
            "Frequent Browsers",
            "Frequent Buyers",
            "Geo-Targeted Shoppers",
            "High-Intent Visitors",
            "Lookalike Audiences",
            "Loyalty Program Members",
            "New to Brand",
            "New to Category",
            "Promo Responders",
            "Repeat Buyers",
            "Seasonal Shoppers",
            "Value Shoppers"
          ]
        },
        {
          "column_name": "impressions",
          "suggested_name": "ad_impressions",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Number of times the ad was displayed to users.",
          "constraints": "Non-negative integer"
        },
        {
          "column_name": "frequency",
          "suggested_name": "ad_frequency",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Number of times a person is exposed to the same advertisement within a given platform.",
          "formula": "Impressions / Unique Users"
        },
        {
          "column_name": "reach",
          "suggested_name": "ad_reach",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Total number of unique users who saw the ad.",
          "formula": "Total Impressions / Ad Frequency"
        },
        {
          "column_name": "clicks",
          "suggested_name": "clicks",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Total number of user clicks on the ad.",
          "constraints": "Non-negative integer"
        },
        {
          "column_name": "ctr_percent",
          "suggested_name": "click_through_rate_percent",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Click-through rate as a percentage of impressions.",
          "formula": "(Clicks / Impressions) * 100",
          "constraints": "Value between 0 and 100"
        },
        {
          "column_name": "conversions",
          "suggested_name": "conversions",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Number of desired actions completed by users (e.g., purchases).",
          "constraints": "Non-negative integer"
        },
        {
          "column_name": "conversion_rate_percent",
          "suggested_name": "conversion_rate_percent",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Percentage of users who converted after clicking.",
          "constraints": "Value between 0 and 100"
        },
        {
          "column_name": "actual_spend_to_date",
          "suggested_name": "actual_spend_to_date",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Total amount spent on the campaign up to the current date.",
          "constraints": "Non-negative numeric value"
        },
        {
          "column_name": "attributed_sales_value",
          "suggested_name": "attributed_sales_value",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Sales revenue attributed to the campaign.",
          "constraints": "Non-negative numeric value"
        },
        {
          "column_name": "roas",
          "suggested_name": "return_on_ad_spend",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Return on Ad Spend; ratio of revenue to ad spend.",
          "formula": "attributed_sales_value / actual_spend_to_date"
        },
        {
          "column_name": "cpc",
          "suggested_name": "cost_per_click",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Cost per click; average cost incurred per ad click.",
          "formula": "Ad Spend / Clicks"
        },
        {
          "column_name": "cpa",
          "suggested_name": "cost_per_acquisition",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Cost per acquisition; average cost per conversion.",
          "formula": "Ad Spend / Conversions"
        },
        {
          "column_name": "date",
          "suggested_name": "record_date",
          "data_type": "STRING",
          "nullable": true,
          "description": "The date associated with the record, used for time-based analysis."
        },
        {
          "column_name": "remaining_budget",
          "suggested_name": "remaining_campaign_budget",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Unspent portion of the campaign budget.",
          "constraints": "Non-negative numeric value"
        },
        {
          "column_name": "video_starts",
          "suggested_name": "video_starts",
          "data_type": "INTEGER",
          "nullable": true,
          "description": "Number of times a video ad started playing."
        },
        {
          "column_name": "video_plays",
          "suggested_name": "video_plays",
          "data_type": "INTEGER",
          "nullable": true,
          "description": "Total number of times the ad started playing"
        },
        {
          "column_name": "video_first_quartile",
          "suggested_name": "video_views_first_quartile",
          "data_type": "INTEGER",
          "nullable": true,
          "description": "Number of views reaching 25% of the video."
        },
        {
          "column_name": "video_midpoint",
          "suggested_name": "video_views_midpoint",
          "data_type": "INTEGER",
          "nullable": true,
          "description": "Number of views reaching 50% of the video."
        },
        {
          "column_name": "video_third_quartile",
          "suggested_name": "video_views_third_quartile",
          "data_type": "INTEGER",
          "nullable": true,
          "description": "Number of views reaching 75% of the video."
        },
        {
          "column_name": "video_completions",
          "suggested_name": "video_completions",
          "data_type": "INTEGER",
          "nullable": true,
          "description": "Number of times the video was watched till the end."
        },
        {
          "column_name": "video_completion_rate_percent",
          "suggested_name": "video_completion_rate_percent",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Percentage of video starts that were completed.",
          "constraints": "Value between 0 and 100"
        },
        {
          "column_name": "avg_watch_time",
          "suggested_name": "average_video_watch_time",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Average time users spent watching the video ad."
        },
        {
          "column_name": "add_to_cart_events",
          "suggested_name": "add_to_cart_events",
          "data_type": "INTEGER",
          "nullable": true,
          "description": "Number of times users added products to cart from the ad."
        },
        {
          "column_name": "new_to_brand_conversions",
          "suggested_name": "new_to_brand_conversions",
          "data_type": "INTEGER",
          "nullable": true,
          "description": "Purchases by customers who have not bought from the brand in a set period."
        },
        {
          "column_name": "dwell_time",
          "suggested_name": "dwell_time",
          "data_type": "INTEGER",
          "nullable": true,
          "description": "Average time users spent engaging with the ad or landing page.",
          "formula": "Total time spent on PDP or landing page ÷ Total visits"
        },
        {
          "column_name": "gross_rating_point",
          "suggested_name": "gross_rating_point",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Measure of total ad exposure across the target audience.",
          "formula": "Reach % × Frequency for total population in a traditional media campaign."
        },
        {
          "column_name": "target_audience_rating_point",
          "suggested_name": "target_audience_rating_point",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "GRP specific to the intended target audience.",
          "formula": "Reach % × Frequency for defined target group (e.g., women 25–44 age group)."
        },
        {
          "column_name": "delivered_messages",
          "suggested_name": "delivered_messages",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Number of media impressions or communications actually sent or served."
        },
        {
          "column_name": "message_opens",
          "suggested_name": "message_opens",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "Number of users who opened an email, push, or other message."
        },
        {
          "column_name": "unsubscribe_bounce_rates",
          "suggested_name": "unsubscribe_and_bounce_rates",
          "data_type": "FLOAT",
          "nullable": true,
          "description": "% of users who unsubscribed or whose messages bounced from the total sent."
        },
        {
          "column_name": "audience_id",
          "suggested_name": "audience_id",
          "data_type": "STRING",
          "nullable": true,
          "description": "Identifier linking the performance data to a specific audience segment."
        }
      ],
      "primary_key": [
        "campaign_id",
        "date"
      ]
    },
    {
      "table_name": "clickstream",
