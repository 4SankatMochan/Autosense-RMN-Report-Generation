  "relationships": [
    {
      "from_table": "campaign_metadata",
      "to_table": "campaign_performance",
      "relationship_type": "one-to-many",
      "foreign_key": "campaign_id",
      "description": "One campaign can have multiple performance records (daily/periodic)"
    },
    {
      "from_table": "campaign_metadata",
      "to_table": "clickstream",
      "relationship_type": "one-to-many",
      "foreign_key": "campaign_ad_id",
      "description": "Campaign ads generate multiple clickstream events"
    },
    {
      "from_table": "campaign_metadata",
      "to_table": "transaction_data",
      "relationship_type": "one-to-many",
      "foreign_key": "campaign_id",
      "description": "Campaigns can result in multiple transactions"
    },
    {
      "from_table": "clickstream",
      "to_table": "transaction_data",
      "relationship_type": "one-to-many",
      "foreign_key": "user_id",
      "description": "User sessions can lead to transactions"
    },
    {
      "from_table": "campaign_performance",
      "to_table": "audience_data",
      "relationship_type": "many-to-many",
      "foreign_key": "audience_id",
      "description": "Campaign performance can be segmented by audience"
    }
  ],
  "query_patterns": {
    "campaign_analysis": [
      "SELECT campaign_id, SUM(impressions), SUM(clicks), SUM(conversions) FROM campaign_performance WHERE date >= '2024-01-01' GROUP BY campaign_id",
      "SELECT media_type, AVG(ctr_percent) FROM campaign_performance GROUP BY media_type",
      "SELECT cm.brand_name, SUM(cp.attributed_sales_value) FROM campaign_metadata cm JOIN campaign_performance cp ON cm.campaign_id = cp.campaign_id GROUP BY cm.brand_name"
    ],
    "performance_metrics": [
      "SELECT campaign_id, (attributed_sales_value / actual_spend_to_date) as calculated_roas FROM campaign_performance WHERE actual_spend_to_date > 0",
      "SELECT AVG(conversion_rate_percent), AVG(click_through_rate_percent) FROM campaign_performance",
      "SELECT media_type, SUM(clicks), SUM(impressions) FROM campaign_performance GROUP BY media_type"
    ],
    "customer_journey": [
      "SELECT user_id, COUNT(DISTINCT session_id) as sessions, COUNT(*) as total_events FROM clickstream GROUP BY user_id",
      "SELECT c.user_id, c.session_id, t.order_id, t.order_amount FROM clickstream c JOIN transaction_data t ON c.user_id = t.user_id WHERE c.purchase = 1",
      "SELECT event_type, COUNT(*) as event_count FROM clickstream GROUP BY event_type"
    ],
    "audience_performance": [
      "SELECT audience_segment, AVG(conversion_value) as avg_value FROM audience_data GROUP BY audience_segment",
      "SELECT audience_segment, SUM(audience_size) FROM audience_data WHERE is_converted = 1 GROUP BY audience_segment"
    ]
  }
  
