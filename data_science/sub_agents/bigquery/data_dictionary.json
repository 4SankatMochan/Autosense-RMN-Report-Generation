            "Display",
            "Search",
            "Video",
            "Shoppable Display",
            "Email",
            "In-App Ads",
            "Programmatic Display",
            "Programmatic Video",
            "Social Ads (Retail-activated)",
            "CTV",
            "DOOH",
            "In-Store Media",
            "Push Notification",
            "SMS / Mobile Messaging",
            "Loyalty Portal Ads",
            "Retail Media Video/OTT"
          ]
        },
        {
          "column_name": "channels",
          "suggested_name": "channels",
          "data_type": "STRING",
          "nullable": true,
          "description": "Marketing or traffic channels driving the user to the site.",
          "enum_values": [
            "Onsite",
            "App",
            "Offsite",
            "Channel-CTV",
            "In-store"
          ]
        },
        {
          "column_name": "device_type",
          "suggested_name": "device_type",
          "data_type": "STRING",
          "nullable": true,
          "description": "Type of device used by the user (e.g., mobile, tablet)."
        },
        {
          "column_name": "traffic_source",
          "suggested_name": "traffic_source",
          "data_type": "STRING",
          "nullable": true,
