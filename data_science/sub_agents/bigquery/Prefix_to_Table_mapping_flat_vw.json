{
  "conventions": {
    "prefix_usage": "Use a 3-character prefix (cp_, cm_, cs_, tx_, aud_) on projected columns in views and aggregated outputs to indicate source table and avoid ambiguous names.",
    "note_on_cardinality": "Avoid grouping by high-cardinality event/order identifiers (session_id, order_id, event_id) unless the use-case explicitly requires them; they will explode cardinality.",
    "deterministic_choice": "When selecting a single metadata value within a group prefer deterministic aggregates (MAX or MIN) rather than ANY_VALUE to avoid non-determinism."
  },
